{"swagger": "2.0", "info": {"title": "ERAS API", "description": "Emergency Report and Alert System API. **Authentication:** Use JWT only. Obtain a token from `POST /api/auth/token/` (phone + password) or `POST /api/auth/login/`, then click **Authorize** above and enter: `Bearer <your_access_token>`.", "version": "v1"}, "host": "eras-api.onrender.com", "schemes": ["https"], "basePath": "/api", "consumes": ["application/json"], "produces": ["application/json"], "securityDefinitions": {"Bearer": {"type": "apiKey", "name": "Authorization", "in": "header", "description": "JWT token from POST /api/auth/token/ or /api/auth/login/. Example: Bearer &lt;your_access_token&gt;"}}, "security": [{"Bearer": []}], "paths": {"/admin/citizens/": {"get": {"operationId": "admin_citizens_list", "description": "List all citizens with optional filters.", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["admin"]}, "parameters": []}, "/admin/citizens/pending-kyc/": {"get": {"operationId": "admin_citizens_pending-kyc_list", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["admin"]}, "parameters": []}, "/admin/citizens/unverified/": {"get": {"operationId": "admin_citizens_unverified_list", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["admin"]}, "parameters": []}, "/admin/citizens/verified/": {"get": {"operationId": "admin_citizens_verified_list", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["admin"]}, "parameters": []}, "/admin/citizens/{id}/": {"get": {"operationId": "admin_citizens_read", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["admin"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/admin/dashboard/": {"get": {"operationId": "admin_dashboard_list", "description": "Get admin dashboard statistics", "parameters": [], "responses": {"200": {"description": "Dashboard stats", "schema": {"type": "object", "properties": {"total_stations": {"type": "integer"}, "active_stations": {"type": "integer"}, "total_operators": {"type": "integer"}, "active_operators": {"type": "integer"}, "total_citizens": {"type": "integer"}, "stations_by_type": {"type": "object", "additionalProperties": {"type": "integer"}}}}}}, "tags": ["admin"]}, "parameters": []}, "/admin/incidents/": {"get": {"operationId": "admin_incidents_list", "description": "Admin: all incidents (monitoring).", "parameters": [], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/OperatorIncident"}}}}, "tags": ["admin"]}, "parameters": []}, "/admin/kyc/approved/": {"get": {"operationId": "admin_kyc_approved_list", "description": "List citizens with approved KYC.", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["admin"]}, "parameters": []}, "/admin/kyc/pending/": {"get": {"operationId": "admin_kyc_pending_list", "description": "List citizens with pending/processing/flagged KYC.", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["admin"]}, "parameters": []}, "/admin/kyc/rejected/": {"get": {"operationId": "admin_kyc_rejected_list", "description": "List citizens with rejected KYC.", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["admin"]}, "parameters": []}, "/admin/kyc/{id}/": {"get": {"operationId": "admin_kyc_read", "description": "Get citizen KYC details; fetches latest status from microservice.", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["admin"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/admin/kyc/{id}/approve/": {"post": {"operationId": "admin_kyc_approve_create", "description": "Manually mark KYC as approved (override).", "parameters": [], "responses": {"201": {"description": ""}}, "tags": ["admin"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/admin/kyc/{id}/reject/": {"post": {"operationId": "admin_kyc_reject_create", "description": "Reject KYC with reason.", "parameters": [], "responses": {"201": {"description": ""}}, "tags": ["admin"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/admin/operators/": {"get": {"operationId": "admin_operators_list", "description": "List all operators (admin only)", "parameters": [{"name": "station_id", "in": "query", "description": "Filter by station ID", "type": "string"}, {"name": "is_active", "in": "query", "description": "Filter by active status (true/false)", "type": "boolean"}], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/Operator"}}}}, "tags": ["admin"]}, "parameters": []}, "/admin/operators/create/": {"post": {"operationId": "admin_operators_create_create", "description": "Create a new operator account (admin only)", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/OperatorCreate"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/Operator"}}}, "tags": ["admin"]}, "parameters": []}, "/admin/operators/{id}/": {"get": {"operationId": "admin_operators_read", "description": "Get operator details (admin only)", "parameters": [], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Operator"}}}, "tags": ["admin"]}, "put": {"operationId": "admin_operators_update", "description": "Update operator (admin only)", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/OperatorUpdate"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Operator"}}}, "tags": ["admin"]}, "delete": {"operationId": "admin_operators_delete", "description": "Delete operator (soft delete) (admin only)", "parameters": [], "responses": {"204": {"description": "No content"}}, "tags": ["admin"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/admin/operators/{id}/reassign-station/": {"patch": {"operationId": "admin_operators_reassign-station_partial_update", "description": "Reassign operator to a different active station (admin only)", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/OperatorReassignStation"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Operator"}}}, "tags": ["admin"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/admin/operators/{id}/reset-password/": {"post": {"operationId": "admin_operators_reset-password_create", "description": "Reset operator password (admin only)", "parameters": [], "responses": {"200": {"description": "Password reset successful", "schema": {"type": "object", "properties": {"message": {"type": "string"}, "temporary_password": {"type": "string"}}}}}, "tags": ["admin"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/admin/stations/": {"get": {"operationId": "admin_stations_list", "description": "List all stations (admin only)", "parameters": [], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/StationList"}}}}, "tags": ["admin"]}, "post": {"operationId": "admin_stations_create", "description": "Create a new station (admin only)", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Station"}}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/Station"}}}, "tags": ["admin"]}, "parameters": []}, "/admin/stations/{id}/": {"get": {"operationId": "admin_stations_read", "description": "Get station details (admin only)", "parameters": [], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Station"}}}, "tags": ["admin"]}, "put": {"operationId": "admin_stations_update", "description": "Update station (admin only)", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Station"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Station"}}}, "tags": ["admin"]}, "patch": {"operationId": "admin_stations_partial_update", "description": "", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/Station"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/Station"}}}, "tags": ["admin"]}, "delete": {"operationId": "admin_stations_delete", "description": "Delete station (soft delete) (admin only)", "parameters": [], "responses": {"204": {"description": "No content"}}, "tags": ["admin"]}, "parameters": [{"name": "id", "in": "path", "description": "A UUID string identifying this station.", "required": true, "type": "string", "format": "uuid"}]}, "/auth/change-password/": {"post": {"operationId": "auth_change-password_create", "description": "Change user password", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/ChangePassword"}}], "responses": {"200": {"description": "Password changed successfully", "schema": {"type": "object", "properties": {"message": {"type": "string"}}}}, "400": {"description": "Bad Request - Validation errors"}, "401": {"description": "Unauthorized - Authentication credentials not provided"}}, "tags": ["auth"]}, "parameters": []}, "/auth/login/": {"post": {"operationId": "auth_login_create", "description": "Login with phone number or email", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/UserLogin"}}], "responses": {"200": {"description": "Login successful", "schema": {"type": "object", "properties": {"id": {"type": "string"}, "phone": {"type": "string"}, "full_name": {"type": "string"}, "email": {"type": "string"}, "role": {"type": "string"}, "profile_image": {"type": "string", "nullable": true}, "access_token": {"type": "string"}, "refresh_token": {"type": "string"}, "station": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "type": {"type": "string"}}, "nullable": true}}}}, "400": {"description": "Bad Request - Invalid credentials"}}, "tags": ["auth"]}, "parameters": []}, "/auth/me/": {"get": {"operationId": "auth_me_list", "description": "Get current user profile", "parameters": [], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/UserProfile"}}, "401": {"description": "Unauthorized - Authentication credentials not provided"}}, "tags": ["auth"]}, "parameters": []}, "/auth/profile/": {"patch": {"operationId": "auth_profile_partial_update", "description": "Update user profile", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/UserUpdate"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/UserProfile"}}, "400": {"description": "Bad Request - Validation errors"}, "401": {"description": "Unauthorized - Authentication credentials not provided"}}, "tags": ["auth"]}, "parameters": []}, "/auth/refresh/": {"post": {"operationId": "auth_refresh_create", "description": "Refresh access token using refresh token", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"required": ["refresh_token"], "type": "object", "properties": {"refresh_token": {"description": "JWT refresh token", "type": "string"}}}}], "responses": {"200": {"description": "New access token", "schema": {"type": "object", "properties": {"access_token": {"type": "string"}}}}, "400": {"description": "Bad Request - Refresh token required"}, "401": {"description": "Unauthorized - Invalid refresh token"}}, "tags": ["auth"]}, "parameters": []}, "/auth/register/": {"post": {"operationId": "auth_register_create", "description": "Register a new citizen account", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/UserRegistration"}}], "responses": {"201": {"description": "Registration successful", "schema": {"type": "object", "properties": {"id": {"type": "string"}, "phone": {"type": "string"}, "full_name": {"type": "string"}, "email": {"type": "string"}, "role": {"type": "string"}, "profile_image": {"type": "string", "nullable": true}, "access_token": {"type": "string"}, "refresh_token": {"type": "string"}}}}, "400": {"description": "Bad Request - Validation errors"}}, "tags": ["auth"]}, "parameters": []}, "/health/": {"get": {"operationId": "health_list", "description": "Health check endpoint to verify API is running", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["health"]}, "parameters": []}, "/incidents/mine/": {"get": {"operationId": "incidents_mine_list", "description": "List incidents reported by the current user (newest first).", "parameters": [], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/IncidentDetail"}}}}, "tags": ["incidents"]}, "parameters": []}, "/incidents/mine/{id}/feedback/": {"post": {"operationId": "incidents_mine_feedback_create", "description": "Citizen feedback after service; closes incident as resolved.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/CitizenIncidentFeedback"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/IncidentDetail"}}}, "tags": ["incidents"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/incidents/report/": {"post": {"operationId": "incidents_report_create", "description": "Report an emergency: multipart audio + GPS. Audio is sent to Voice-to-Service for Amharic/English text and category (Medical/Police/Fire/None); the backend assigns the nearest matching station.", "parameters": [{"name": "audio", "in": "formData", "description": "Audio file (wav/mp3 as accepted by Voice-to-Service)", "required": true, "type": "file"}, {"name": "latitude", "in": "formData", "required": true, "type": "number"}, {"name": "longitude", "in": "formData", "required": true, "type": "number"}, {"name": "location_accuracy_m", "in": "formData", "required": false, "type": "number"}, {"name": "altitude_m", "in": "formData", "required": false, "type": "number"}, {"name": "address_line", "in": "formData", "required": false, "type": "string"}, {"name": "notes", "in": "formData", "required": false, "type": "string"}], "responses": {"201": {"description": "", "schema": {"$ref": "#/definitions/IncidentDetail"}}}, "consumes": ["multipart/form-data", "application/x-www-form-urlencoded"], "tags": ["incidents"]}, "parameters": []}, "/kyc/callback/": {"post": {"operationId": "kyc_callback_create", "description": "POST /api/kyc/callback/ - KYC microservice pushes status updates (immediate sync).\nSecured with X-KYC-Callback-Secret header.", "parameters": [], "responses": {"201": {"description": ""}}, "tags": ["kyc"]}, "parameters": []}, "/kyc/status/": {"get": {"operationId": "kyc_status_list", "description": "Get current user's KYC status (synced from microservice). Citizen `status_display`: approved | rejected | submitted (under review). Poll after submit until approved or rejected.", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["kyc"]}, "parameters": []}, "/kyc/submit/": {"post": {"operationId": "kyc_submit_create", "description": "Submit KYC documents (ID front, ID back, selfie) as multipart/form-data. **Auth:** Bearer JWT (citizen role). Returns immediately with `submission_id` and `status: submitted` (under review). Poll GET /api/kyc/status/ for final result. Re-submit only allowed when previous status is rejected.", "parameters": [{"name": "id_type", "in": "formData", "description": "e.g. national_id, passport", "type": "string"}, {"name": "id_number", "in": "formData", "required": true, "type": "string"}, {"name": "full_name", "in": "formData", "type": "string"}, {"name": "email", "in": "formData", "required": true, "type": "string"}, {"name": "id_front", "in": "formData", "required": true, "type": "file"}, {"name": "id_back", "in": "formData", "required": true, "type": "file"}, {"name": "selfie", "in": "formData", "required": true, "type": "file"}], "responses": {"201": {"description": "Submitted; under review"}}, "consumes": ["multipart/form-data", "application/x-www-form-urlencoded"], "tags": ["kyc"]}, "parameters": []}, "/media/{file_id}/": {"get": {"operationId": "media_read", "description": "Get audio file redirect URL by incident id.", "parameters": [], "responses": {"200": {"description": ""}, "302": {"description": "Redirect to file URL"}, "404": {"description": "Incident/audio not found"}}, "tags": ["media"]}, "parameters": [{"name": "file_id", "in": "path", "required": true, "type": "string"}]}, "/operator/citizens/": {"get": {"operationId": "operator_citizens_list", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["operator"]}, "parameters": []}, "/operator/citizens/verified/": {"get": {"operationId": "operator_citizens_verified_list", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["operator"]}, "parameters": []}, "/operator/citizens/{id}/": {"get": {"operationId": "operator_citizens_read", "description": "", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["operator"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/operator/dashboard/": {"get": {"operationId": "operator_dashboard_list", "description": "Get operator dashboard with station info", "parameters": [], "responses": {"200": {"description": "Operator dashboard", "schema": {"type": "object", "properties": {"my_station": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "type": {"type": "string"}}}, "pending_incidents": {"type": "integer"}, "total_incidents_today": {"type": "integer"}, "recent_incidents": {"type": "array", "items": {"type": "object"}}}}}}, "tags": ["operator"]}, "parameters": []}, "/operator/incidents/": {"get": {"operationId": "operator_incidents_list", "description": "List incidents routed to the operator’s station.", "parameters": [], "responses": {"200": {"description": "", "schema": {"type": "array", "items": {"$ref": "#/definitions/OperatorIncident"}}}}, "tags": ["operator"]}, "parameters": []}, "/operator/incidents/{id}/": {"get": {"operationId": "operator_incidents_read", "description": "Incident detail for operators (same station only).", "parameters": [], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/OperatorIncident"}}}, "tags": ["operator"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/operator/incidents/{id}/read/": {"post": {"operationId": "operator_incidents_read_create", "description": "Mark incident as read for the current operator (idempotent).", "parameters": [], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/OperatorIncident"}}}, "tags": ["operator"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/operator/incidents/{id}/status/": {"patch": {"operationId": "operator_incidents_status_partial_update", "description": "Update incident status (operator at assigned station).", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/OperatorIncidentStatusUpdate"}}], "responses": {"200": {"description": "", "schema": {"$ref": "#/definitions/OperatorIncident"}}}, "tags": ["operator"]}, "parameters": [{"name": "id", "in": "path", "required": true, "type": "string"}]}, "/operator/realtime-config/": {"get": {"operationId": "operator_realtime-config_list", "description": "Get websocket connection details for operator realtime incident feed.", "parameters": [], "responses": {"200": {"description": ""}}, "tags": ["operator"]}, "parameters": []}, "/operator/stations/": {"get": {"operationId": "operator_stations_l